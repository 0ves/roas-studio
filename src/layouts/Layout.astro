---
import "../styles/globals.css";
import Navbar from "../components/navigation/Navbar";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ROAS STUDIO",
  description = "We build digital experiences that help businesses grow.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <Navbar client:idle />

    <main>
      <slot />
    </main>
<script type="module">
  import "../scripts/main";
</script>
  </body>
</html>