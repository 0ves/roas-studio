---
import Container from "../ui/Container.astro";

const steps = [
  {
    number: "01",
    title: "Discover",
    description:
      "We learn about your business, audience, competitors and goals to create a strategy tailored to your growth.",
  },
  {
    number: "02",
    title: "Plan & Design",
    description:
      "We define the user experience, marketing strategy and technical architecture before development begins.",
  },
  {
    number: "03",
    title: "Build & Market",
    description:
      "We develop your website, launch digital marketing campaigns and integrate AI solutions where they create the most value.",
  },
  {
    number: "04",
    title: "Optimize & Scale",
    description:
      "Through continuous monitoring, analytics and optimization, we improve performance, increase conversions and support long-term business growth.",
  },
];
---

<!-- APPLIED BALANCED TOP PADDING: changed py-12 lg:py-16 to pt-6 pb-12 lg:pt-8 lg:pb-16 -->
<section id="process" class="relative overflow-hidden pt-6 pb-12 lg:pt-8 lg:pb-16">

  <!-- Background Grid -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-20 bg-[linear-gradient(to_right,#f3f4f6_1px,transparent_1px),linear-gradient(to_bottom,#f3f4f6_1px,transparent_1px)] bg-[size:72px_72px] opacity-20"
  />

  <Container>
    <div class="max-w-3xl">
      <!-- REDUCED: mb-5 to mb-3 -->
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.35em] text-neutral-500">
        Our Process
      </p>

      <!-- REDUCED: text sizes scaled down by 1 notch -->
      <h2 class="text-3xl font-semibold tracking-[-0.04em] leading-tight md:text-4xl lg:text-5xl">
        Simple, transparent and built around collaboration.
      </h2>

      <!-- REDUCED: mt-8 to mt-4, text-lg to text-base, leading-8 to leading-7 -->
      <p class="mt-4 max-w-2xl text-base leading-7 text-neutral-600">
        Every successful project follows a structured process designed to
        reduce uncertainty, improve communication and deliver better results.
      </p>
    </div>

    <!-- REDUCED: mt-24 to mt-10 -->
    <div class="mt-10 border-t border-neutral-200">
      {
        steps.map((step) => (
          <div
            /* REDUCED: gap-10 to gap-6, py-12 to py-6, grid-cols-[120px_1fr] to grid-cols-[80px_1fr] */
            class="group relative grid gap-6 border-b border-neutral-200 py-6 transition-all duration-300 hover:bg-neutral-50/60 md:grid-cols-[80px_1fr]"
          >
            <div
              class="absolute left-0 top-0 h-full w-px origin-top scale-y-0 bg-neutral-900 transition-transform duration-700 ease-out group-hover:scale-y-100"
            />

            <span class="text-sm font-semibold tracking-[0.25em] text-neutral-400 transition-colors duration-300 group-hover:text-neutral-900">
              {step.number}
            </span>

            <div>
              <!-- REDUCED: text-3xl to text-xl md:text-2xl -->
              <h3
                class="text-xl md:text-2xl font-semibold tracking-tight transition-all duration-300 group-hover:translate-x-3"
              >
                {step.title}
              </h3>

              <!-- REDUCED: mt-4 to mt-1.5, leading-8 to leading-6, added text-sm -->
              <p
                class="mt-1.5 max-w-2xl text-sm leading-6 text-neutral-500 transition-colors duration-300 group-hover:text-neutral-700"
              >
                {step.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>