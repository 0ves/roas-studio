---
import Button from "../ui/Button.astro";
---

<section class="relative overflow-hidden bg-black text-white">

  <!-- ========================================================= -->
  <!-- BACKGROUND -->
  <!-- ========================================================= -->

  <div class="absolute inset-0 overflow-hidden">

    <!-- Main Background -->
    <div
      class="absolute inset-0"
      style="
        background:
          radial-gradient(circle at 12% 18%, rgba(173,255,47,.28), transparent 34%),
          radial-gradient(circle at 88% 82%, rgba(25,25,112,.65), transparent 46%),
          radial-gradient(circle at 55% 55%, rgba(173,255,47,.08), transparent 55%),
          linear-gradient(
            135deg,
            #000000 0%,
            #05070B 25%,
            #0D1535 60%,
            #191970 100%
          );
      "
    ></div>

    <!-- Green Light -->
    <div
      class="absolute left-[2%] top-[5%] h-[900px] w-[900px] rounded-full blur-[240px]"
      style="
        background:
        radial-gradient(
          circle,
          rgba(173,255,47,.45) 0%,
          rgba(173,255,47,.22) 35%,
          rgba(173,255,47,.08) 65%,
          transparent 82%
        );
      "
    ></div>

    <!-- Blue Light -->
    <div
      class="absolute right-[-10%] bottom-[-15%] h-[900px] w-[900px] rounded-full blur-[240px]"
      style="
        background:
        radial-gradient(
          circle,
          rgba(25,25,112,.55) 0%,
          rgba(25,25,112,.28) 45%,
          transparent 80%
        );
      "
    ></div>

    <!-- Grid -->
    <div
      class="absolute inset-0 opacity-[0.04]"
      style="
        background-image:
          linear-gradient(rgba(255,255,255,.10) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,.10) 1px, transparent 1px);
        background-size:80px 80px;
      "
    ></div>

    <!-- RAOS STUDIO -->
    <div
      class="pointer-events-none absolute inset-0 flex items-center justify-center"
    >
      <h2
        class="select-none whitespace-nowrap text-[11vw] font-black uppercase tracking-[-0.08em]
               bg-gradient-to-r
               from-[#ADFF2F]/25
               via-white/12
               to-[#191970]/30
               bg-clip-text
               text-transparent"
      >
        RAOS STUDIO
      </h2>
    </div>

  </div>

  <!-- ========================================================= -->
  <!-- CONTENT -->
  <!-- ========================================================= -->

  <div
    class="relative z-10 mx-auto flex min-h-screen max-w-7xl items-center justify-between gap-12 px-6 py-24 lg:px-8"
  >

    <!-- LEFT -->
    <div
      class="max-w-[620px] rounded-[36px]
             border border-white/10
             bg-slate-900/45
             p-8
             shadow-[0_40px_120px_rgba(0,0,0,.55)]
             backdrop-blur-3xl
             md:p-12"
    >
      <p
        class="mb-8 text-xs font-semibold uppercase tracking-[0.45em] text-[#ADFF2F]/80"
      >
        DIGITAL GROWTH AGENCY
      </p>

      <h1
        class="text-5xl font-semibold leading-[0.88] tracking-[-0.06em] md:text-7xl lg:text-[6.5rem]"
      >
        <div class="overflow-hidden">
          <span class="hero-line block">Design.</span>
        </div>
        <div class="overflow-hidden">
          <span class="hero-line block">Build.</span>
        </div>
        <div class="overflow-hidden">
          <span class="hero-line block">Grow.</span>
        </div>
      </h1>

      <p
        id="hero-description"
        class="mt-8 max-w-xl text-lg leading-8 text-white/70"
      >
        We help ambitious businesses create modern websites,
        digital marketing systems and AI-powered automation
        that drive measurable business growth.
      </p>

      <div
        id="hero-buttons"
        class="mt-12 flex flex-wrap gap-4"
      >
        <Button href="#contact">
          Start Your Project
        </Button>
      <!-- 
        <Button href="/work">
          View Our Work
        </Button>
        -->
      </div>

      <div
        id="hero-stats"
        class="mt-16 grid grid-cols-2 gap-10 border-t border-white/10 pt-8"
      >
        <div>
          <h3 class="text-3xl font-semibold text-[#ADFF2F]">
            10+
          </h3>
          <p
            id="hero-eyebrow"
            class="mt-2 text-xs font-semibold uppercase tracking-[0.45em] text-white/70"
          >
            Projects Delivered
          </p>
        </div>

        <div>
          <h3 class="text-3xl font-semibold text-[#ADFF2F]">
            &lt;24h
          </h3>
          <p class="mt-2 text-xs font-semibold uppercase tracking-[0.45em] text-white/70">
            Avg Response
          </p>
        </div>
      </div>
    </div>

    <!-- RIGHT: DESKTOP ONLY -->
    <div class="relative hidden h-[500px] w-[440px] lg:block">

      <!-- Scaled-Down Image 1 -->
      <img
        id="hero-dashboard"
        src="/images/camera.webp"
        alt="Website Design"
        class="absolute right-0 top-0 w-[320px] rounded-[22px] border border-white/10 shadow-[0_25px_75px_rgba(0,0,0,.6)] object-cover"
      />

      <!-- Scaled-Down Floating Chart -->
      

      <!-- Compact Floating Video -->
      <div
        id="hero-mobile"
        class="absolute bottom-0 right-4 w-[140px] overflow-hidden rounded-[22px] border border-white/15 bg-neutral-900 shadow-2xl"
      >
        <video
          src="/videos/social-media.mp4"
          autoplay
          loop
          muted
          playsinline
          class="h-full w-full object-cover"
        ></video>
      </div>

    </div>

  </div>

</section>

<script type="module">
  import { initHeroAnimation } from "../../scripts/heroAnimation";

  initHeroAnimation();
</script>