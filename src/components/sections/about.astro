---
import Container from "../ui/Container.astro";
import TeamCard from "../ui/TeamCard.astro";
import { team } from "../../data/team";
---

<section
  id="about"
  class="relative overflow-hidden py-24 lg:py-32"
>

  <!-- Background Grid -->

  <div
    class="absolute inset-0 -z-20 bg-[linear-gradient(to_right,#f3f4f6_1px,transparent_1px),linear-gradient(to_bottom,#f3f4f6_1px,transparent_1px)] bg-[size:72px_72px] opacity-20"
  />

  <!-- Soft Glow -->

  <div
    class="absolute left-1/2 top-0 -z-10 h-[650px] w-[650px] -translate-x-1/2 rounded-full bg-blue-500/5 blur-[120px]"
  />

  <Container>

    <div class="mx-auto max-w-4xl text-center">

      <p class="mb-5 text-sm font-semibold uppercase tracking-[0.35em] text-neutral-500">
        About Us
      </p>

      <h2
        class="text-4xl font-semibold leading-tight tracking-[-0.04em] md:text-5xl lg:text-6xl"
      >
        The People Behind The Work
      </h2>

      <p
        class="mx-auto mt-8 max-w-3xl text-lg leading-8 text-neutral-600"
      >
        We are a multidisciplinary team combining software engineering,
        digital strategy and performance marketing to help businesses build
        stronger digital experiences and achieve sustainable growth. Every
        project is a collaborative effort where technology, creativity and
        marketing work together to deliver measurable results.
      </p>

    </div>

    <div
      class="mt-20 grid gap-8 md:grid-cols-2 xl:grid-cols-3"
    >

      {
        team.map((member) => (
          <TeamCard {...member} />
        ))
      }

    </div>

    <div
      class="mx-auto mt-24 max-w-4xl border-t border-neutral-200 pt-16 text-center"
    >

      <h3 class="text-3xl font-semibold tracking-tight">
        Three Specialists. One Team.
      </h3>

      <p
        class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-neutral-600"
      >
        We believe exceptional digital products are created through
        collaboration. By combining engineering, digital marketing and
        growth strategy, we help businesses design, build and grow with
        confidence.
      </p>

    </div>

  </Container>

</section>