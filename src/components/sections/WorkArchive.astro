---
import Container from "../ui/Container.astro";
import { projects } from "../../data/projects";
---

<section class="relative overflow-hidden py-24 lg:py-32">

  <!-- Grid Background -->

  <div
    class="absolute inset-0 -z-20 bg-[linear-gradient(to_right,#f3f4f6_1px,transparent_1px),linear-gradient(to_bottom,#f3f4f6_1px,transparent_1px)] bg-[size:72px_72px] opacity-20"
  />

  <!-- Glow -->

  <div
    class="absolute left-1/2 top-0 -z-10 h-[700px] w-[700px] -translate-x-1/2 rounded-full bg-blue-500/5 blur-[140px]"
  />

  <Container>

    <div class="mx-auto max-w-4xl text-center">

      <p class="mb-5 text-sm font-semibold uppercase tracking-[0.35em] text-neutral-500">
        Our Work
      </p>

      <h1
        class="text-5xl font-semibold leading-tight tracking-[-0.05em] md:text-6xl lg:text-7xl"
      >
        Projects That
        <br />
        Drive Growth.
      </h1>

      <p
        class="mx-auto mt-8 max-w-2xl text-lg leading-8 text-neutral-600"
      >
        Every project represents our commitment to thoughtful design,
        modern engineering and measurable business impact.
      </p>

    </div>

    <div class="mt-24 grid gap-10 lg:grid-cols-2">

      {
        projects.map((project) => (

          <a
            href={project.href}
            class="group overflow-hidden rounded-[28px] border border-neutral-200 bg-white transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl"
          >

            <div class="overflow-hidden">

              <img
                src={project.image}
                alt={project.title}
                class="aspect-[16/10] w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />

            </div>

            <div class="p-8">

              <p class="text-sm uppercase tracking-[0.25em] text-neutral-500">
                {project.category}
              </p>

              <h2 class="mt-3 text-3xl font-semibold tracking-tight">
                {project.title}
              </h2>

              <div
                class="mt-8 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.15em]"
              >
                View Case Study
                <span>→</span>
              </div>

            </div>

          </a>

        ))
      }

    </div>

  </Container>

</section>