---
import Container from "../ui/Container.astro";

const services = [
  {
    number: "01",
    title: "Performance Marketing & Meta Ads",
    description:
      "Data-driven Meta and Google Ads management designed to aggressively scale your reach, lower acquisition costs, and maximize your measurable ROI.",
  },
  {
    number: "02",
    title: "End-to-End Content Production",
    description:
      "We script, shoot, and edit high-retention video content. From viral reels to professional brand assets, we build the creative that fuels your campaigns.",
  },
  {
    number: "03",
    title: "Social Media & Page Management",
    description:
      "Complete handling of your online presence. We manage daily posting schedules, community engagement, and profile optimization to build a loyal audience.",
  },
  {
    number: "04",
    title: "Influencer Marketing",
    description:
      "Sourcing and collaborating with the right creators to amplify your brand's voice, drive targeted traffic, and build authentic social proof at scale.",
  },
  {
    number: "05",
    title: "Web Dev & AI Automation",
    description:
      "High-converting landing pages and AI-powered workflows designed to capture the traffic we generate, automate follow-ups, and seamlessly convert leads.",
  },
];
---

<!-- REDUCED: py-24 lg:py-32 changed to py-12 lg:py-16 -->
<section id="services" class="relative overflow-hidden py-12 lg:py-16">

  <!-- Background Grid -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-30 bg-[linear-gradient(to_right,#f3f4f6_1px,transparent_1px),linear-gradient(to_bottom,#f3f4f6_1px,transparent_1px)] bg-[size:72px_72px] opacity-50"
  />

  <!-- Blue Glow -->
  <div
    aria-hidden="true"
    class="absolute -right-56 top-0 -z-20 h-[650px] w-[650px] rounded-full bg-blue-500/5 blur-[140px]"
  />

  <!-- Secondary Glow -->
  <div
    aria-hidden="true"
    class="absolute -left-56 bottom-0 -z-20 h-[500px] w-[500px] rounded-full bg-violet-500/5 blur-[120px]"
  />

  <!-- REDUCED: top-20 to top-10, text sizes scaled down -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-10 -z-10 -translate-x-1/2 select-none whitespace-nowrap text-[7rem] font-bold uppercase tracking-[-0.08em] text-neutral-900/[0.03] md:text-[10rem]"
  >
    SERVICES
  </div>

  <!-- Fade -->
  <div
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-b from-transparent via-white/20 to-white"
  />

  <Container>
    <div class="relative max-w-3xl">
      <!-- REDUCED: mb-5 to mb-3 -->
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.35em] text-neutral-500">
        Our Services
      </p>

      <!-- REDUCED: text sizes scaled down by 1 notch -->
      <h2 class="text-3xl font-semibold leading-tight tracking-[-0.04em] md:text-4xl lg:text-5xl">
        Growth-focused marketing to scale your brand.
      </h2>

      <!-- REDUCED: mt-8 to mt-4, text-lg to text-base -->
      <p class="mt-4 max-w-2xl text-base leading-7 text-neutral-600">
        From Meta ads and influencer outreach to scripting, shooting, and daily page management, we handle the entire pipeline to drive real business growth.
      </p>
    </div>

    <!-- REDUCED: mt-20 to mt-10 -->
    <div class="relative mt-10 border-t border-neutral-200">
      {
        services.map((service) => (
          <a
            href="#contact"
            /* REDUCED: gap-10 to gap-6, py-10 to py-6 */
            class="group relative grid cursor-pointer gap-6 border-b border-neutral-200 py-6 transition-all duration-300 hover:bg-white/60 md:grid-cols-[60px_1fr_auto]"
          >
            <div
              class="absolute left-0 top-0 h-full w-px origin-top scale-y-0 bg-neutral-900 transition-transform duration-1000 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-y-100"
            />

            <span class="text-sm font-medium text-neutral-400 transition-colors duration-300 group-hover:text-neutral-900">
              {service.number}
            </span>

            <div>
              <!-- REDUCED: text-3xl to text-xl md:text-2xl -->
              <h3 class="text-xl md:text-2xl font-semibold tracking-tight transition-all duration-300 group-hover:translate-x-3">
                {service.title}
              </h3>

              <!-- REDUCED: mt-3 to mt-1.5, adjusted line height -->
              <p class="mt-1.5 max-w-xl text-sm leading-6 text-neutral-500 transition-colors duration-300 group-hover:text-neutral-700">
                {service.description}
              </p>
            </div>

            <!-- Arrow Container -->
            <div class="flex items-center justify-start md:justify-end">
              <svg
                class="h-5 w-5 transition-all duration-300 group-hover:translate-x-3 group-hover:-translate-y-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M7 17L17 7" />
                <path d="M8 7h9v9" />
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</section>